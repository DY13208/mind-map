{
  "mcpServers": {
    "mind-map": {
      "command": "node",
      "args": ["simple-mind-map/bin/mcpServer.mjs"],
      "env": {
        "MIND_MAP_API": "http://127.0.0.1:1234"
      }
    },
    "file-kb": {
      "type": "http",
      "url": "http://127.0.0.1:8990/file-kb-mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${env:FILE_KB_MCP_TOKEN}"
      }
    }
  }
}
