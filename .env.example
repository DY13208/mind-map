# 与 启动.bat 同一级。密钥复用原账号。
# 存储桶复用 yiran，导图写到独立前缀 TENCENT_COS_LOCATION，不要和 media/ 混。

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mind_map
PGUSER=postgres
PGPASSWORD=

# 腾讯云 COS（复用原桶，仅换文件夹）
COS_TYPE=tencent
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=yiran-1301008423
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_CUSTOM_DOMAIN=https://yiran-1301008423.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SCHEME=https
TENCENT_COS_LOCATION=mind-map
TENCENT_COS_ACL=private

# MCP。Docker 模式下对外走同一端口的 /mcp，不必单独开 3847。
MCP_PORT=3847
# 设置后，HTTP MCP 请求必须带 Authorization: Bearer <token>。
# 启用企业微信登录时必填且至少 32 字符，防止 MCP 绕过网页身份认证。
# MCP_TOKEN=

# 本机 WorkBuddy 转 API（https://github.com/yxxawa/workbuddy_to_api）
# 启动脚本会自动拉取到 workbuddy_to_api/ 并监听 3000；页面经 /wb-api 代理到这里。
# WORKBUDDY_API_DIR=../workbuddy_to_api
# WORKBUDDY_API=http://127.0.0.1:3000

# Docker 对外端口（启动-Docker.bat / docker compose）
# MIND_MAP_PORT=8080

# 企业微信扫码单点登录。填好全部参数后再改为 true；false 时保持原来的免登录模式。
WECOM_AUTH_ENABLED=false
# 企业 ID（企业微信管理后台 -> 我的企业）
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
# 自建应用 AgentId 和 Secret（应用管理 -> 对应自建应用）
WECOM_AGENT_ID=1000002
WECOM_SECRET=
# 必须与外部实际访问地址一致，路径固定如下。生产环境强烈建议 HTTPS。
# 示例：https://mindmap.example.com/api/auth/wecom/callback
WECOM_REDIRECT_URI=https://mindmap.example.com/api/auth/wecom/callback
# 可选：企业微信内嵌二维码自定义样式，只接受 HTTPS 地址。
WECOM_QR_STYLE_URL=
# 前端外部访问源（协议 + 域名 + 可选端口）。Docker 同域部署时可留空。
# 本地跨端口开发示例：http://192.168.1.20:8081
AUTH_APP_ORIGIN=
# 会话签名密钥，至少 32 字符。可用：openssl rand -hex 32
AUTH_SESSION_SECRET=
# 7 天无活动需重新登录；最长 30 天必须重新扫码。
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_MAX_HOURS=720
# auto 会根据外部请求是否 HTTPS 自动添加 Secure；生产 HTTPS 推荐显式 true。
AUTH_COOKIE_SECURE=auto

# 本地/内网开发者调试密钥。配置后登录页会出现「开发者密钥登录」，无需企业微信扫码。
# 仅 localhost / 127.0.0.1 / 内网 IP 生效；公网域名默认不可用。
AUTH_DEV_BYPASS_KEY=yiran-dev-local-bypass-key-2026-stillgroup
AUTH_DEV_BYPASS_USER_NAME=本地开发者
AUTH_DEV_BYPASS_USER_ID=dev-local
# 仅在确有需要时允许公网域名使用开发者密钥（生产环境不要开启）
# AUTH_DEV_BYPASS_ALLOW_PUBLIC=false
