# 与 启动.bat 同一级。密钥复用原账号。
# 存储桶复用 yiran，导图写到独立前缀 TENCENT_COS_LOCATION，不要和 media/ 混。

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mind_map
PGUSER=postgres
PGPASSWORD=

# 协作事件总线。默认 postgres LISTEN/NOTIFY；Docker 会改为 redis。
# Redis 只做已提交事件的跨实例分发，不是文档权威。补偿仍走 GET /operations。
# COLLAB_EVENT_BUS=postgres
# REDIS_URL=redis://127.0.0.1:16379
# COLLAB_REDIS_STREAM=collab:events

# 腾讯云 COS（复用原桶，仅换文件夹）
COS_TYPE=tencent
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=yiran-1301008423
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_CUSTOM_DOMAIN=https://yiran-1301008423.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SCHEME=https
TENCENT_COS_LOCATION=mind-map
TENCENT_COS_ACL=private

# MCP。Docker 模式下对外走同一端口的 /mcp，不必单独开 3847。
MCP_PORT=3847
# 设置后，HTTP MCP 请求必须带 Authorization: Bearer <token>。
# 启用企业微信登录时必填且至少 32 字符，防止 MCP 绕过网页身份认证。
# MCP_TOKEN=

# Knowledge MCP（Wiki 全库只读）。MCP 接入页会签发 wikiToken，经 /knowledge-mcp 反代。
# KNOWLEDGE_MCP_JWT_SECRET=          # 必填才能在 mcp-access 复制 mind-map-wiki
# Wiki MCP 个人令牌默认长期有效（静态 Token）；只有主动更换 KNOWLEDGE_MCP_JWT_SECRET 才会失效
# KNOWLEDGE_MCP_JWT_TTL_SEC=7776000  # 仅影响 CLI/signToken 短期票；0=无 exp；接入页签发不受此限制
# KNOWLEDGE_MCP_JWT_ISS=openclaw-liangce
# KNOWLEDGE_MCP_JWT_AUD=knowledge-mcp
# KNOWLEDGE_MCP_BIND=127.0.0.1       # 跨机再改为 0.0.0.0 并配防火墙

# 本机 WorkBuddy 转 API（https://github.com/yxxawa/workbuddy_to_api）
# 启动脚本会自动拉取到 workbuddy_to_api/ 并监听 3000；页面经 /wb-api 代理到这里。
# WORKBUDDY_API_DIR=../workbuddy_to_api
# WORKBUDDY_API=http://127.0.0.1:3000

# MCP upload_attachment：挂载到容器 /workbuddy 的宿主机目录
# 默认 ./data/workbuddy（任意机器可写，适合服务器）。本机有 WorkBuddy 时改成实际产物目录，例如：
# WORKBUDDY_HOST_DIR=C:/Users/你的用户名/WorkBuddy
# Linux 服务器示例：
# WORKBUDDY_HOST_DIR=/var/lib/workbuddy
# WORKBUDDY_HOST_DIR=./data/workbuddy

# OpenClaw Gateway（龙虾，默认 Docker 容器；前端 /assistant 经 /openclaw-api 代理）
# Start-Docker.bat 会自动：生成 Token、写入配置、docker compose 拉起 openclaw-gateway
# OPENCLAW_MODE=docker          # docker（默认）| auto（Docker 失败再试 WSL）| wsl
# OPENCLAW_IMAGE=openclaw/openclaw:latest
# OPENCLAW_API=http://127.0.0.1:4623
# OPENCLAW_PORT=4623              # 宿主机端口（容器内仍是 18789）
# OPENCLAW_GATEWAY_TOKEN=       # 留空则 Start-Docker 自动生成并写入本文件
# DEEPSEEK_API_KEY=             # 助理默认模型。留空时 Start-Docker 会复用本机 WorkBuddy 的 DeepSeek Key（不进 git）
# OPENCLAW_WSL_DISTRO=Ubuntu    # 仅 OPENCLAW_MODE=wsl 时使用
# OPENCLAW_ENABLE_CHAT_COMPLETIONS=1
# Start-Docker 会把 Token 写入 docker/runtime-config.local.js（已 gitignore），助理页自动读取

# Cognee 知识库（可选；设 COGNEE_ENABLED=1 后 Start-Docker 会拉起，无镜像会拉取/构建并打印进度）
# COGNEE_ENABLED=0
# COGNEE_ENABLED=1
# COGNEE_DIR=D:\cognee
# COGNEE_PORT=8320
# OpenClaw 容器内访问本机 Cognee（不要用 127.0.0.1）
# COGNEE_URL=http://host.docker.internal:8320
# COGNEE_API_KEY=                 # Cognee API Key；留空则保留 OpenClaw 卷里已有 key
# COGNEE_DATASET=liangce

# Docker 对外端口（启动-Docker.bat / docker compose）
# MIND_MAP_PORT=8080

# 企业微信扫码单点登录。填好全部参数后再改为 true；false 时保持原来的免登录模式。
WECOM_AUTH_ENABLED=false
# 企业 ID（企业微信管理后台 -> 我的企业）
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
# 自建应用 AgentId 和 Secret（应用管理 -> 对应自建应用）
WECOM_AGENT_ID=1000002
WECOM_SECRET=
# 必须与外部实际访问地址一致，路径固定如下。生产环境强烈建议 HTTPS。
# 示例：https://mindmap.example.com/api/auth/wecom/callback
WECOM_REDIRECT_URI=https://mindmap.example.com/api/auth/wecom/callback
# 可选：企业微信内嵌二维码自定义样式，只接受 HTTPS 地址。
WECOM_QR_STYLE_URL=
# 前端外部访问源（协议 + 域名 + 可选端口）。Docker 同域部署时可留空。
# 生产示例：http://xx.stillgroup.net:8989
# 推送到 Wiki 时，脑图附件相对路径 /api/files/... 会拼上此地址（否则 Wiki 域名下点不开）。
AUTH_APP_ORIGIN=
# 额外允许的跨域来源，逗号分隔。内网 IP 与域名并存时可都写上。
# 示例：http://192.168.0.204:8989,http://xx.stillgroup.net:8989
AUTH_ALLOWED_ORIGINS=
# 会话签名密钥，至少 32 字符。可用：openssl rand -hex 32
AUTH_SESSION_SECRET=
# 7 天无活动需重新登录；最长 30 天必须重新扫码。
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_MAX_HOURS=720
# auto 会根据外部请求是否 HTTPS 自动添加 Secure；生产 HTTPS 推荐显式 true。
AUTH_COOKIE_SECURE=auto

# 本地/内网开发者调试密钥。配置后登录页会出现「开发者密钥登录」，无需企业微信扫码。
# 仅 localhost / 127.0.0.1 / 内网 IP 生效；公网域名默认不可用。
AUTH_DEV_BYPASS_KEY=yiran-dev-local-bypass-key-2026-stillgroup
AUTH_DEV_BYPASS_USER_NAME=本地开发者
AUTH_DEV_BYPASS_USER_ID=dev-local
# 推荐：填你在企业微信通讯录里的手机号。开发者登录时会调用企微 API
# 解析成真实 userid，小策 SSO 才能命中已绑定账号（勿再用默认 dev-local）。
# 前提：小策侧该企业微信成员已是 matched 绑定；本配置不会在小策里新建用户。
# AUTH_DEV_BYPASS_MOBILE=13800138000
# 仅在确有需要时允许公网域名使用开发者密钥（生产环境不要开启）
# AUTH_DEV_BYPASS_ALLOW_PUBLIC=false

# ── Yiran / Liangce Django API（同一 Docker 网关端口下的 /yiran/*）──────────
# 把 Yiran 完整 .env 拷到本仓库根目录（已 gitignore，勿提交）：
#   copy C:\Users\YiRan\IdeaProjects\yiran\.env .env.yiran
# Compose 优先读 .env.yiran（403 项：DB/Redis/LLM/Agent…），不要把密钥写进本文件。
# YIRAN_ROOT 仍用于构建时拉取后端代码。
# YIRAN_ROOT=C:/Users/YiRan/IdeaProjects/yiran
# 一键启动：start-with-yiran.bat
# 访问：http://localhost:8080/yiran/api/docs/  （Swagger）
# 脑图协作仍走 /api/*；WorkBuddy 仍保留，经 /wb-api → 宿主机 :3000
# 前端设置里可切换 AI 后端：WorkBuddy | 小策（过渡期双轨）
YIRAN_ROOT=C:/Users/YiRan/IdeaProjects/yiran
# 默认跳过在 compose 里建库，直接使用 .env.yiran 里的真实 Postgres
YIRAN_SKIP_CREATEDB=1
# 一键脚本会在本地 .env 自动生成；至少 32 字符且不要提交。
# MIND_MAP_YIRAN_SSO_SECRET=
# YIRAN_DJANGO_ALLOWED_HOSTS=*
# YIRAN_DOTENV_AUTOLOAD=true
# 小策已独立部署时，填服务端 API 根地址（不要带末尾 /api，也不要写到前端）：
# YIRAN_UPSTREAM=https://xiaoce.example.com
# 远端小策必须配置与本机 .env 相同的 MIND_MAP_YIRAN_SSO_SECRET。

# Cognee 知识图谱 API（经网关 /cognee-api 代理；密钥由服务端注入 X-Api-Key）
# COGNEE_API=http://192.168.0.204:8320
# COGNEE_API_KEY=
# COGNEE_DATASET=liangce

# 节点附件单文件上限（字节）。默认 209715200（200MB）。
# 大文件走 tus 分片断点续传（8MB/片），完成后写入 COS。
# NODE_KNOWLEDGE_MAX_BYTES=209715200
# 小于该值的附件会在上传完成时同步解析；更大的文件先落 COS 再后台解析。
# NODE_KNOWLEDGE_EXTRACT_WAIT_BYTES=16777216
# tus 临时分片目录。容器重启会丢未完成上传，客户端会按指纹重新创建（内容哈希仍去重）。
# NODE_KNOWLEDGE_TUS_DIR=/tmp/mind-map-tus
# 附件文本解析并发。默认 2。
# NODE_KNOWLEDGE_EXTRACT_CONCURRENCY=2

# Knowledge Compiler (Docker defaults enabled; local server opt-in)
KNOWLEDGE_COMPILER_ENABLED=true
KNOWLEDGE_SYNC_INTERVAL=300
KNOWLEDGE_OUTPUT_DIR=/app/knowledge

# Wiki extension: docker compose -f docker-compose.yml -f docker-compose.wiki.yml
DOCMOST_VERSION=0.96.0
DOCMOST_PORT=3040
# Wiki 新窗口地址（侧栏「Wiki」打开）。留空则 Start-Docker 自动用 PUBLIC_HOST/本机 IP：
#   http://<本机IP>:3040
# 不要默认写 localhost/127.0.0.1，否则页面用局域网 IP 打开时会跨域。
# DOCMOST_APP_URL=http://192.168.1.75:3040
DOCMOST_INTERNAL_URL=http://docmost:3000
# 脑图更新后自动编译并推送到 Docmost（个人空间 / 团队空间，权限跟 room ACL）
DOCMOST_SYNC_ENABLED=true
# DOCMOST credentials generated by node scripts/wiki-env.js in .secrets/wiki.env.
# APP_SECRET and POSTGRES_PASSWORD must never be committed.
# Start-Docker / docker-up.js 会把 wiki.env 映射为容器内：
#   DOCMOST_DATABASE_URL / DOCMOST_APP_SECRET / DOCMOST_SSO_SECRET
# 用于侧栏「Wiki」单点登录（签发短时票据 → Docmost 设 authToken cookie）。
OPENWIKI_VERSION=0.5.2
OPENWIKI_CONFIG_DIR=/data/openwiki
OPENWIKI_MIND_MAP_MCP_URL=http://app/mcp

# ── Docker 构建期代理（仅影响 docker build，不影响运行中的容器）────────────
# 构建容器不会继承宿主机的代理，直连 deb.debian.org / 大流量在国内会被掐断，
# 症状是 Dockerfile 里 apt-get update 卡几百秒后报 Connection failed。
# 本机跑 Clash 时填宿主机的混合端口；host.docker.internal 由 Docker Desktop 解析。
# 能直连 Debian 源的网络留空即可。
BUILD_HTTP_PROXY=http://host.docker.internal:7897
BUILD_HTTPS_PROXY=http://host.docker.internal:7897
BUILD_NO_PROXY=localhost,127.0.0.1,postgres,redis
