# 与 启动.bat 同一级。密钥复用原账号。
# 存储桶复用 yiran，导图写到独立前缀 TENCENT_COS_LOCATION，不要和 media/ 混。

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mind_map
PGUSER=postgres
PGPASSWORD=

# 协作事件总线。默认 postgres LISTEN/NOTIFY；Docker 会改为 redis。
# Redis 只做已提交事件的跨实例分发，不是文档权威。补偿仍走 GET /operations。
# COLLAB_EVENT_BUS=postgres
# REDIS_URL=redis://127.0.0.1:16379
# COLLAB_REDIS_STREAM=collab:events

# 腾讯云 COS（复用原桶，仅换文件夹）
COS_TYPE=tencent
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=yiran-1301008423
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_CUSTOM_DOMAIN=https://yiran-1301008423.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SCHEME=https
TENCENT_COS_LOCATION=mind-map
TENCENT_COS_ACL=private

# MCP。Docker 模式下对外走同一端口的 /mcp，不必单独开 3847。
MCP_PORT=3847
# 设置后，HTTP MCP 请求必须带 Authorization: Bearer <token>。
# 启用企业微信登录时必填且至少 32 字符，防止 MCP 绕过网页身份认证。
# MCP_TOKEN=

# 本机 WorkBuddy 转 API（https://github.com/yxxawa/workbuddy_to_api）
# 启动脚本会自动拉取到 workbuddy_to_api/ 并监听 3000；页面经 /wb-api 代理到这里。
# WORKBUDDY_API_DIR=../workbuddy_to_api
# WORKBUDDY_API=http://127.0.0.1:3000

# 本机 OpenClaw Gateway（默认 18789；前端 /assistant 经 /openclaw-api 代理）
# Start-Docker.bat 会自动：唤醒 WSL、启动 gateway、并开启 Chat Completions
# OPENCLAW_API=http://127.0.0.1:18789
# OPENCLAW_PORT=18789
# OPENCLAW_WSL_DISTRO=Ubuntu
# OPENCLAW_TRAY_EXE=D:\openclaw\OpenClawTray\OpenClaw.Tray.WinUI.exe
# OPENCLAW_ENABLE_CHAT_COMPLETIONS=1
# Start-Docker 会把 Token 写入 docker/runtime-config.local.js（已 gitignore），助理页自动读取，无需弹窗填写
# 助理页「连接设置」仅作手动兜底

# Docker 对外端口（启动-Docker.bat / docker compose）
# MIND_MAP_PORT=8080

# 企业微信扫码单点登录。填好全部参数后再改为 true；false 时保持原来的免登录模式。
WECOM_AUTH_ENABLED=false
# 企业 ID（企业微信管理后台 -> 我的企业）
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
# 自建应用 AgentId 和 Secret（应用管理 -> 对应自建应用）
WECOM_AGENT_ID=1000002
WECOM_SECRET=
# 必须与外部实际访问地址一致，路径固定如下。生产环境强烈建议 HTTPS。
# 示例：https://mindmap.example.com/api/auth/wecom/callback
WECOM_REDIRECT_URI=https://mindmap.example.com/api/auth/wecom/callback
# 可选：企业微信内嵌二维码自定义样式，只接受 HTTPS 地址。
WECOM_QR_STYLE_URL=
# 前端外部访问源（协议 + 域名 + 可选端口）。Docker 同域部署时可留空。
# 生产示例：http://xx.stillgroup.net:8989
AUTH_APP_ORIGIN=
# 额外允许的跨域来源，逗号分隔。内网 IP 与域名并存时可都写上。
# 示例：http://192.168.0.204:8989,http://xx.stillgroup.net:8989
AUTH_ALLOWED_ORIGINS=
# 会话签名密钥，至少 32 字符。可用：openssl rand -hex 32
AUTH_SESSION_SECRET=
# 7 天无活动需重新登录；最长 30 天必须重新扫码。
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_MAX_HOURS=720
# auto 会根据外部请求是否 HTTPS 自动添加 Secure；生产 HTTPS 推荐显式 true。
AUTH_COOKIE_SECURE=auto

# 本地/内网开发者调试密钥。配置后登录页会出现「开发者密钥登录」，无需企业微信扫码。
# 仅 localhost / 127.0.0.1 / 内网 IP 生效；公网域名默认不可用。
AUTH_DEV_BYPASS_KEY=yiran-dev-local-bypass-key-2026-stillgroup
AUTH_DEV_BYPASS_USER_NAME=本地开发者
AUTH_DEV_BYPASS_USER_ID=dev-local
# 推荐：填你在企业微信通讯录里的手机号。开发者登录时会调用企微 API
# 解析成真实 userid，小策 SSO 才能命中已绑定账号（勿再用默认 dev-local）。
# 前提：小策侧该企业微信成员已是 matched 绑定；本配置不会在小策里新建用户。
# AUTH_DEV_BYPASS_MOBILE=13800138000
# 仅在确有需要时允许公网域名使用开发者密钥（生产环境不要开启）
# AUTH_DEV_BYPASS_ALLOW_PUBLIC=false

# ── Yiran / Liangce Django API（同一 Docker 网关端口下的 /yiran/*）──────────
# 把 Yiran 完整 .env 拷到本仓库根目录（已 gitignore，勿提交）：
#   copy C:\Users\YiRan\IdeaProjects\yiran\.env .env.yiran
# Compose 优先读 .env.yiran（403 项：DB/Redis/LLM/Agent…），不要把密钥写进本文件。
# YIRAN_ROOT 仍用于构建时拉取后端代码。
# YIRAN_ROOT=C:/Users/YiRan/IdeaProjects/yiran
# 一键启动：start-with-yiran.bat
# 访问：http://localhost:8080/yiran/api/docs/  （Swagger）
# 脑图协作仍走 /api/*；WorkBuddy 仍保留，经 /wb-api → 宿主机 :3000
# 前端设置里可切换 AI 后端：WorkBuddy | 小策（过渡期双轨）
YIRAN_ROOT=C:/Users/YiRan/IdeaProjects/yiran
# 默认跳过在 compose 里建库，直接使用 .env.yiran 里的真实 Postgres
YIRAN_SKIP_CREATEDB=1
# 一键脚本会在本地 .env 自动生成；至少 32 字符且不要提交。
# MIND_MAP_YIRAN_SSO_SECRET=
# YIRAN_DJANGO_ALLOWED_HOSTS=*
# YIRAN_DOTENV_AUTOLOAD=true
# 小策已独立部署时，填服务端 API 根地址（不要带末尾 /api，也不要写到前端）：
# YIRAN_UPSTREAM=https://xiaoce.example.com
# 远端小策必须配置与本机 .env 相同的 MIND_MAP_YIRAN_SSO_SECRET。
