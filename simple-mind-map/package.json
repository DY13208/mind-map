{
  "name": "simple-mind-map",
  "version": "0.14.0-fix.3",
  "description": "一个简单的web在线思维导图",
  "authors": [
    {
      "name": "思绪思维导图",
      "url": "https://sxmind.cn/"
    }
  ],
  "types": "./types/index.d.ts",
  "typings": "./types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanglin2/mind-map"
  },
  "scripts": {
    "lint": "eslint src/",
    "format": "prettier --write .",
    "types": "npx -p typescript tsc index.js --declaration --allowJs --emitDeclarationOnly --outDir types --target es2017 --skipLibCheck & node ./bin/createPluginsTypeFiles.js",
    "wsServe": "node ./bin/wsServer.mjs",
    "collabServe": "node ./bin/collabServer.js",
    "test:collab": "node ./test/collabYjs.test.js",
    "test:auth": "node ./test/auth.test.js",
    "test:auth:integration": "node ./test/auth.integration.test.js",
    "test:collab:integration": "node ./test/collabWebsocket.integration.test.js",
    "test:collab:large": "node ./test/collabLarge.integration.test.js",
    "mcp": "node ./bin/mcpServer.mjs",
    "mcpHttp": "node ./bin/mcpServer.mjs --http"
  },
  "module": "index.js",
  "main": "./dist/simpleMindMap.umd.min.js",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@svgdotjs/svg.js": "3.2.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "deepmerge": "^1.5.2",
    "eventemitter3": "^4.0.7",
    "jszip": "^3.10.1",
    "katex": "^0.16.8",
    "lib0": "^0.2.117",
    "mdast-util-from-markdown": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "quill": "^2.0.3",
    "tern": "^0.24.3",
    "uuid": "^9.0.0",
    "ws": "^7.5.9",
    "xml-js": "^1.6.11",
    "y-webrtc": "^10.2.5",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.8",
    "zod": "^3.24.2"
  },
  "keywords": [
    "javascript",
    "svg",
    "mind-map",
    "mindMap",
    "MindMap"
  ],
  "devDependencies": {
    "eslint": "^8.25.0",
    "prettier": "^2.7.1"
  }
}
