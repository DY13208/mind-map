event: message
data: {"result":{"tools":[{"name":"list_maps","description":"列出全部思维导图房间，含标题和给人类打开的 share_url","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"execution":{"taskSupport":"forbidden"}},{"name":"create_map","description":"新建一张导图并返回房间号、分享链接。人类用 share_url 即可加入同一房间协同。","inputSchema":{"type":"object","properties":{"title":{"type":"string","description":"根节点标题"},"room_key":{"type":"string","description":"可选自定义房间号"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"get_map","description":"读取一张导图。format=outline（默认）只返回大纲（每行带 uid，默认最多 800 个节点，超出请 search_nodes）；format=full 返回树，超大图会截断或改回 outline。日常先 outline。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"format":{"type":"string","enum":["outline","full"],"description":"outline=只返回大纲；full=只返回完整树"},"max_nodes":{"type":"integer","minimum":1,"maximum":5000,"description":"outline/full 最大节点数，默认 800"}},"required":["room_key"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"search_nodes","description":"在指定导图里按文字搜索节点","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"query":{"type":"string","description":"搜索关键词"}},"required":["room_key","query"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"list_todos","description":"列出导图「待办」分支中的任务。默认不返回已完成任务；这不是执行工具，不会修改导图。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"include_completed":{"type":"boolean","description":"是否同时返回已完成任务，默认false"}},"required":["room_key"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"prepare_todo","description":"处理任何业务待办前必须先调用。读取任务子树，匹配任意SOP目标，并返回其C检查项、P计划、版本和候选项。若match_status=needs_confirmation，先在对话中请用户选择候选SOP；若not_found，任务留在待办。该工具不会执行业务，也不会修改导图。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"task":{"type":"string","description":"待办任务uid或任务标题"},"sop":{"type":"string","description":"可选，用户确认后的SOP目标uid、标题或完整路径"}},"required":["room_key","task"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"complete_todo","description":"AI完成P后调用。必须逐项提交prepare_todo返回的全部C叶子检查结果；仅当全部passed=true且SOP版本未变化时，才把整棵任务从「待办」移动到「已完成」。执行过程和错误不要写进导图。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"task":{"type":"string","description":"待办任务uid或任务标题"},"sop_uid":{"type":"string","description":"prepare_todo返回的matched_sop.uid"},"sop_version":{"type":"string","description":"prepare_todo返回的matched_sop.version"},"check_results":{"type":"array","items":{"type":"object","properties":{"check_uid":{"type":"string","description":"C叶子检查项uid"},"passed":{"type":"boolean","description":"该检查项是否已经通过"},"evidence":{"type":"string","description":"可选验收依据，仅用于本次校验，不写入思维导图"}},"required":["check_uid","passed"],"additionalProperties":false},"description":"全部C叶子检查项的结果"},"summary":{"type":"string","description":"可选精简完成结果；保存为任务元数据，不新增过程节点"}},"required":["room_key","task","sop_uid","sop_version","check_results"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"propose_sop_improvement","description":"发现任意业务SOP的C或P存在缺失时生成结构化建议。此工具只返回建议和proposal_id，不修改思维导图；必须先把建议展示给用户确认。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"sop_uid":{"type":"string","description":"要完善的SOP目标uid"},"section":{"type":"string","enum":["C","P"],"description":"修改C检查规则或P执行计划"},"action":{"type":"string","enum":["add","update","delete"],"description":"建议的修改动作"},"node_uid":{"type":"string","description":"update/delete时必填，必须是对应C/P下的内容节点uid"},"content":{"type":"string","description":"add/update时的新节点内容"},"reason":{"type":"string","description":"提出修改的业务原因"}},"required":["room_key","sop_uid","section","action","reason"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"apply_sop_improvement","description":"仅在用户已经明确同意propose_sop_improvement展示的建议后调用。建议内容、proposal_id和SOP版本必须一致，否则拒绝写入。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"proposal_id":{"type":"string","description":"propose_sop_improvement返回的proposal_id"},"sop_uid":{"type":"string","description":"建议中的sop_uid"},"sop_version":{"type":"string","description":"建议中的sop_version"},"section":{"type":"string","enum":["C","P"],"description":"建议中的section"},"action":{"type":"string","enum":["add","update","delete"],"description":"建议中的action"},"node_uid":{"type":"string","description":"建议中的node_uid"},"content":{"type":"string","description":"建议中的content"},"reason":{"type":"string","description":"建议中的reason"},"user_confirmed":{"type":"boolean","description":"只有用户在当前对话明确同意后才能传true"}},"required":["room_key","proposal_id","sop_uid","sop_version","section","action","reason","user_confirmed"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"add_node","description":"在指定节点下新增子节点。parent 可以是 uid、root，或路径如「根节点/产品」。成功只返回 uid，不返回整图。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"text":{"type":"string","description":"节点文字"},"parent":{"type":"string","description":"父节点 uid / root / 文字路径，默认加到根下"},"note":{"type":"string","description":"可选备注"},"confirm_sop_change":{"type":"boolean","description":"父节点属于SOP时，必须先获得用户确认并传true"}},"required":["room_key","text"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"update_node","description":"修改节点文字或备注。node 优先用 get_map outline 里的 uid；也可用完整标题、部分文字或 根/父/子 路径。成功只返回 uid。工具报错即未写入。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"node":{"type":"string","description":"节点 uid 或文字路径"},"text":{"type":"string","description":"新文字"},"note":{"type":"string","description":"新备注"},"confirm_sop_change":{"type":"boolean","description":"节点属于SOP时，必须先获得用户确认并传true"}},"required":["room_key","node"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"delete_node","description":"删除节点及其全部子节点。不能删根节点。成功只返回 uid，不返回整图。","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"node":{"type":"string","description":"节点 uid 或文字路径"},"confirm_sop_change":{"type":"boolean","description":"节点属于SOP时，必须先获得用户确认并传true"}},"required":["room_key","node"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"replace_tree","description":"用完整树一次性覆盖整张导图。适合 AI 生成整图。tree 格式：{ data: { text }, children: [...] }","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"title":{"type":"string","description":"可选标题"},"tree":{"description":"思维导图树，{ data: { text }, children: [] }"},"confirm_sop_change":{"type":"boolean","description":"覆盖含SOP的导图前，必须先获得用户确认并传true"}},"required":["room_key"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"rename_map","description":"重命名导图房间标题","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"},"title":{"type":"string","description":"新标题"}},"required":["room_key","title"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"delete_map","description":"删除整张导图（房间、存储都会删）","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"}},"required":["room_key"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}},{"name":"get_share_link","description":"生成给人类打开的网页协同链接，打开后自动加入同一房间","inputSchema":{"type":"object","properties":{"room_key":{"type":"string","description":"房间号"}},"required":["room_key"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"execution":{"taskSupport":"forbidden"}}]},"jsonrpc":"2.0","id":2}

