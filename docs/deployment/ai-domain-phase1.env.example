# 将下面项目合并进服务器原有 .env；不要用本文件覆盖整个 .env。
# 第一阶段继续使用 8989，两个域名解析到同一公网地址。
PUBLIC_HOST=ai.stillgroup.net
AUTH_APP_ORIGIN=https://ai.stillgroup.net:8989
WECOM_REDIRECT_URI=https://ai.stillgroup.net:8989/api/auth/wecom/callback
AUTH_COOKIE_SECURE=true
# 保留现有内网来源；以下保留旧公网来源供过渡期接口调用。
AUTH_ALLOWED_ORIGINS=https://ai.stillgroup.net:8989,https://xx.stillgroup.net:8989

# 第一阶段固定 Wiki 为原地址，防止 docker-up 按新的 PUBLIC_HOST 自动推导。
# 服务器若有不同的现有值，保留服务器原值。
DOCMOST_APP_URL=https://xx.stillgroup.net:3040

# 以下项目保持服务器原值，不要因为本阶段换域名而替换：
# WECOM_CORP_ID / WECOM_AGENT_ID / WECOM_SECRET
# AUTH_SESSION_SECRET / MCP_TOKEN / KNOWLEDGE_MCP_JWT_SECRET
# PostgreSQL / COS / Redis / DOCMOST_INTERNAL_URL / MIND_MAP_INTERNAL_URL
# COGNEE_SSO_REDIRECT_URI / HRMS_SSO_REDIRECT_URI / YIRAN_UPSTREAM
# WORKBUDDY_REDIRECT_URI / ONEID_REDIRECT_URI
