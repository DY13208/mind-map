[
  {
    "uid": "1f580e83-3ced-43da-9f52-1e72f68992e0",
    "parent_uid": "4a7e2f37-9d05-4696-8505-042e0d77ec47",
    "position": "N555555555555550",
    "data": {
      "text": "<p>请假</p>"
    }
  },
  {
    "uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "parent_uid": "1f580e83-3ced-43da-9f52-1e72f68992e0",
    "position": "K8ZZZZZZZZZZZZZY",
    "data": {
      "text": "<p>部门负责人</p>"
    }
  },
  {
    "uid": "6fd5774c-f5de-4153-a6a2-3a7f23d1621d",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "7777777777777777",
    "data": {
      "text": "所有请假至少提前1天（制度原文）"
    }
  },
  {
    "uid": "59964d01-623d-4f5c-863f-7f4f7cdfc163",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "EEEEEEEEEEEEEEEE",
    "data": {
      "text": "写明类型:事假/病假/年假/婚假/产假/陪产假/丧假/调休/长假"
    }
  },
  {
    "uid": "5ed509ae-9197-4081-ac86-6a03ad56612f",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "LLLLLLLLLLLLLLLL",
    "data": {
      "text": "事假最小1小时；离开和返回须打卡，否则按忘记打卡"
    }
  },
  {
    "uid": "6535955e-8ea1-4e22-bd63-955055d4cf93",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "QZZZZZZZZZZZZZZZ",
    "data": {
      "text": "病假按标准后补证明，当月内；无证明按事假"
    }
  },
  {
    "uid": "7c2bd83b-304c-4a1a-8162-dcabb6736588",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "VHZZZZZZZZZZZZZZ",
    "data": {
      "text": "<p>工作已交接，假期可覆盖</p>"
    }
  },
  {
    "uid": "bfd17c53-5fe0-4005-85f3-fada27e69942",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "XQZZZZZZZZZZZZZZ",
    "data": {
      "text": "<p>事假:试用期累计≤5天，转正全年累计≤20天</p>"
    }
  },
  {
    "uid": "acffec66-5aea-432b-955c-31a4364c0253",
    "parent_uid": "186c8333-5b89-42c4-ab0b-c08b2a284936",
    "position": "YVHZZZZZZZZZZZZZ",
    "data": {
      "text": "<p>长假(司龄≥5年，最长3个月，仅一次):上级同意+交接人同意</p>"
    }
  },
  {
    "uid": "d1986169-862f-4c95-b476-482eb91e4c4a",
    "parent_uid": "1f580e83-3ced-43da-9f52-1e72f68992e0",
    "position": "NMHZZZZZZZZZZZZY",
    "data": {
      "text": "<p>SSC</p>"
    }
  },
  {
    "uid": "f6c43e2b-f49f-4e38-87f9-e3176d6b9cb4",
    "parent_uid": "d1986169-862f-4c95-b476-482eb91e4c4a",
    "position": "000000000000MH34",
    "data": {
      "text": "<p>类型、时长、材料符合考勤制度</p>"
    }
  },
  {
    "uid": "b646d7fb-3f32-4ee5-b02e-cfe0e92941f3",
    "parent_uid": "d1986169-862f-4c95-b476-482eb91e4c4a",
    "position": "I00000000000B8JJ",
    "data": {
      "text": "病假材料"
    }
  },
  {
    "uid": "7abed490-60a0-476c-87e9-c8652b7bbba7",
    "parent_uid": "b646d7fb-3f32-4ee5-b02e-cfe0e92941f3",
    "position": "5ZZZZZZZZZZZZZZZ",
    "data": {
      "text": "1天:医院病假单（医生开具）"
    }
  },
  {
    "uid": "434af106-0f66-4f07-9e1e-89498b9fca3c",
    "parent_uid": "b646d7fb-3f32-4ee5-b02e-cfe0e92941f3",
    "position": "BZZZZZZZZZZZZZZY",
    "data": {
      "text": "<p><span>超过1天且不足3天:病假单+诊断书；恰好3天按3天及以上标准</span></p>"
    }
  },
  {
    "uid": "d7e20bf6-5241-4f0d-9a6f-ac68f63d9f92",
    "parent_uid": "b646d7fb-3f32-4ee5-b02e-cfe0e92941f3",
    "position": "HZZZZZZZZZZZZZZX",
    "data": {
      "text": "3天及以上:二级(含)以上医院公章病假证明"
    }
  },
  {
    "uid": "96d193e0-6d67-48a3-a1ae-a8f10336ebae",
    "parent_uid": "b646d7fb-3f32-4ee5-b02e-cfe0e92941f3",
    "position": "NZZZZZZZZZZZZZZW",
    "data": {
      "text": "挂号单、无身份信息缴费单不予审核；虚假病假记违纪2次"
    }
  },
  {
    "uid": "03f22c76-f5e7-4eaa-9323-63b550e64676",
    "parent_uid": "b646d7fb-3f32-4ee5-b02e-cfe0e92941f3",
    "position": "TZZZZZZZZZZZZZZV",
    "data": {
      "text": "无证明按事假；病假按60%发薪（扣40%）"
    }
  },
  {
    "uid": "3638b75e-bb6d-4607-8b27-e6d82bb66cd5",
    "parent_uid": "d1986169-862f-4c95-b476-482eb91e4c4a",
    "position": "R000000000005M9R",
    "data": {
      "text": "其他假"
    }
  },
  {
    "uid": "3f8677f3-b1d9-4eb0-bd38-693f660c9937",
    "parent_uid": "3638b75e-bb6d-4607-8b27-e6d82bb66cd5",
    "position": "5ZZZZZZZZZZZZZZZ",
    "data": {
      "text": "年假:司龄满1年未满10年5天（年底统一放）；满10年额外5天可自由支配"
    }
  },
  {
    "uid": "1fdbce03-e37f-4998-9078-fe96ba186c23",
    "parent_uid": "3638b75e-bb6d-4607-8b27-e6d82bb66cd5",
    "position": "BZZZZZZZZZZZZZZY",
    "data": {
      "text": "婚假:领证半年内3天"
    }
  },
  {
    "uid": "adfc90af-3083-426e-ae80-48f07097ffc8",
    "parent_uid": "3638b75e-bb6d-4607-8b27-e6d82bb66cd5",
    "position": "HZZZZZZZZZZZZZZX",
    "data": {
      "text": "产假178天/陪产假15天:结婚证+出生证明+出院小结或病历"
    }
  },
  {
    "uid": "c581f490-15cd-4d6e-8e13-0d5c8ffb2e3f",
    "parent_uid": "3638b75e-bb6d-4607-8b27-e6d82bb66cd5",
    "position": "NZZZZZZZZZZZZZZW",
    "data": {
      "text": "丧假直系3天，省外可+1天路程假"
    }
  },
  {
    "uid": "8ba8a225-312d-4b9d-b6d6-89140486327b",
    "parent_uid": "3638b75e-bb6d-4607-8b27-e6d82bb66cd5",
    "position": "TZZZZZZZZZZZZZZV",
    "data": {
      "text": "调休:提前1天，单次≥2小时，当年底用完；11-12月产生的可延3个月"
    }
  },
  {
    "uid": "9c201b67-0f9a-4b57-842d-6bd43a29d3a3",
    "parent_uid": "d1986169-862f-4c95-b476-482eb91e4c4a",
    "position": "VI00000000002T4V",
    "data": {
      "text": "以下情况拒绝/改类型"
    }
  },
  {
    "uid": "470fb52b-277e-483e-9bff-d29389703345",
    "parent_uid": "9c201b67-0f9a-4b57-842d-6bd43a29d3a3",
    "position": "8ZZZZZZZZZZZZZZZ",
    "data": {
      "text": "未提前1天且非紧急"
    }
  },
  {
    "uid": "eab9669a-0d0c-47d5-a4dd-219859468920",
    "parent_uid": "9c201b67-0f9a-4b57-842d-6bd43a29d3a3",
    "position": "HZZZZZZZZZZZZZZY",
    "data": {
      "text": "病假材料不符标准"
    }
  },
  {
    "uid": "84dc033c-25da-404e-94dc-5a4c98dfa93b",
    "parent_uid": "9c201b67-0f9a-4b57-842d-6bd43a29d3a3",
    "position": "QZZZZZZZZZZZZZZX",
    "data": {
      "text": "调休拆分不足2小时，或已过有效期"
    }
  },
  {
    "uid": "08a2213c-ef12-44a9-8f66-8fd99dc0ff52",
    "parent_uid": "1f580e83-3ced-43da-9f52-1e72f68992e0",
    "position": "QZZZZZZZZZZZZZZY",
